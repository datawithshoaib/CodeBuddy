# Groq API Key (get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Path where generated code is stored (defaults to generated_project)
# PROJECT_ROOT=generated_project

# Optional: Comma-separated list of allowed origins for CORS (default: *)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
